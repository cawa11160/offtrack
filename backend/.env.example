# Optional (enables Spotify search + cover art)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback
FRONTEND_URL=http://localhost:8080
COOKIE_SECRET=dev_cookie_secret_change_me
SPOTIFY_COOKIE_SECURE=false
SPOTIFY_COOKIE_SAMESITE=lax

# Postgres (local, outside docker)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/offtrack

# Auth / session
JWT_SECRET=dev_change_me
JWT_ALG=HS256
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=30
PASSWORD_MIN_LENGTH=10
PASSWORD_SCRYPT_N_LOG2=14
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=1
PASSWORD_SCRYPT_DKLEN=64
PASSWORD_SCRYPT_MAXMEM_MB=64
EMAIL_VERIFICATION_REQUIRED_FOR_ARTIST_UPLOADS=true
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
REFRESH_COOKIE_NAME=offtrack_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Upload security
# If set, clients must include this secret to upload files.
UPLOAD_SECRET=
# If true, /api/uploads and /api/audio/upload require logged-in users.
REQUIRE_AUTH_UPLOADS=true
MAX_UPLOAD_MB=200

# Media storage
# local keeps files under MEDIA_DIR. s3/r2 stores audio at s3://S3_BUCKET/S3_KEY_PREFIX/...
MEDIA_STORAGE_BACKEND=local
MEDIA_DIR=./media
# S3-compatible storage, including Cloudflare R2. Required when MEDIA_STORAGE_BACKEND=s3 or r2.
S3_BUCKET=
S3_KEY_PREFIX=offtrack
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public CDN/base URL. If unset, stream endpoints generate signed URLs.
S3_PUBLIC_BASE_URL=
S3_SIGNED_URL_TTL_SEC=3600

# Abuse protection
RATE_LIMIT_LOGIN_PER_MIN=30
RATE_LIMIT_SIGNUP_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=20
BRUTE_FORCE_MAX_FAILS=8
BRUTE_FORCE_WINDOW_SEC=300
BRUTE_FORCE_BLOCK_SEC=600

# Distributed limiting (optional)
# memory|redis
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Admin security endpoints
ADMIN_API_KEY=

# Comma-separated allowed origins for CORS (dev)
ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# PostHog (optional analytics)
POSTHOG_ENABLED=true
POSTHOG_HOST=https://app.posthog.com
POSTHOG_API_KEY=

# Catalog metadata sync (optional)
OFFTRACK_CONTACT_URL=https://offtrack.local
MUSICBRAINZ_USER_AGENT="Offtrack/0.1 (https://offtrack.local)"
LASTFM_API_KEY=
LASTFM_USER_AGENT=Offtrack/0.1
DISCOGS_TOKEN=
DISCOGS_USER_AGENT="Offtrack/0.1 +https://offtrack.local"

# Lyric AI provider (backend only)
LYRIC_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
# Set true only if you want local text-frame fallback when provider fails
LYRIC_AI_ALLOW_LOCAL_FALLBACK=false
